diff --git a/core/embed/sys/syscall/stm32/syscall_verifiers.c b/core/embed/sys/syscall/stm32/syscall_verifiers.c
index 095081a50ec8c09c8126c7e0c6cc0ed5bb8a2371..6aa11a5a6603be11ab0e6321491047527839f8cb 100644
--- a/core/embed/sys/syscall/stm32/syscall_verifiers.c
+++ b/core/embed/sys/syscall/stm32/syscall_verifiers.c
@@ -468,6 +468,21 @@ access_violation:
   return secfalse;
 }
 
+secbool usb_set_mode__verified(usb_mode_t mode,
+                               const usb_start_params_t *params) {
+  if (!probe_read_access(params, sizeof(*params))) {
+    goto access_violation;
+  }
+  // Copy the parameters to kernel memory before using them
+  usb_start_params_t params_copy = *params;
+  params_copy.serial_number[USB_MAX_STR_SIZE] = '\0';
+  return usb_set_mode(mode, &params_copy);
+
+access_violation:
+  apptask_access_violation();
+  return secfalse;
+}
