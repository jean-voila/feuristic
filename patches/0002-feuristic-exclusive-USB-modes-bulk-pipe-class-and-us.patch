     } else {
         bail_unsupported!();
diff --git a/core/embed/io/usb/unix/usb.c b/core/embed/io/usb/unix/usb.c
index e98844fc10362130908d9623f172b7906b31ad36..b499c366f92fa90ccb21e89efe3db1c280e2bef6 100644
--- a/core/embed/io/usb/unix/usb.c
+++ b/core/embed/io/usb/unix/usb.c
@@ -30,6 +30,7 @@
 
 #include <io/unix/sock.h>
 #include <io/usb.h>
+#include <io/usb_bulk.h>
 #include <io/usb_hid.h>
 #include <io/usb_vcp.h>
 #include <io/usb_webusb.h>
@@ -44,6 +45,9 @@ typedef enum {
   USB_IFACE_TYPE_VCP = 1,
   USB_IFACE_TYPE_HID = 2,
   USB_IFACE_TYPE_WEBUSB = 3,
+  // feuristic: bulk pipe (CCID / MSC). One UDP datagram carries exactly one
+  // frame as defined in io/usb_bulk.h (opcode/event byte + payload).
+  USB_IFACE_TYPE_BULK = 4,
 } usb_iface_type_t;
 
 typedef struct {
@@ -51,10 +55,12 @@ typedef struct {
   usb_iface_type_t type;
   uint16_t port;
   emu_sock_t sock;
-  uint8_t msg[64];
+  uint8_t msg[USB_BULK_FRAME_MAX];
   int msg_len;
 } usb_iface_t;
 
+static bool usb_started = false;
+
 static usb_iface_t usb_ifaces[USBD_MAX_NUM_INTERFACES];
 
 // forward declaration
@@ -79,13 +85,18 @@ void usb_deinit(void) { usb_stop(); }
 secbool usb_start(const usb_start_params_t *params) {
   const char *ip = getenv("TREZOR_UDP_IP");
 
+  if (usb_started) {
+    return sectrue;
+  }
+
   // iterate interfaces
   for (int i = 0; i < USBD_MAX_NUM_INTERFACES; i++) {
     usb_iface_t *iface = &usb_ifaces[i];
     // skip if not HID or WebUSB interface
     if (iface->type != USB_IFACE_TYPE_HID &&
         iface->type != USB_IFACE_TYPE_WEBUSB &&
-        iface->type != USB_IFACE_TYPE_VCP) {
+        iface->type != USB_IFACE_TYPE_VCP &&
+        iface->type != USB_IFACE_TYPE_BULK) {
       continue;
     }
 
@@ -96,15 +107,24 @@ secbool usb_start(const usb_start_params_t *params) {
            NULL);
   }
 
+  usb_started = true;
   return sectrue;
 }
 
 void usb_stop(void) {
+  if (!usb_started) {
+    return;
+  }
   for (int i = 0; i < USBD_MAX_NUM_INTERFACES; i++) {
     usb_iface_t *iface = &usb_ifaces[i];
+    if (iface->type == USB_IFACE_TYPE_DISABLED) {
+      continue;  // never unregister a handle we did not register
+    }
     sock_stop(&iface->sock);
     syshandle_unregister(iface->handle);
+    iface->msg_len = 0;
   }
+  usb_started = false;
 }
 
 secbool usb_hid_add(const usb_hid_info_t *info) {
@@ -146,6 +166,19 @@ secbool usb_vcp_add(const usb_vcp_info_t *info) {
   return secfalse;
 }
 
+secbool usb_bulk_add(const usb_bulk_info_t *info) {
+  if (info->iface_num < USBD_MAX_NUM_INTERFACES) {
+    usb_iface_t *iface = &usb_ifaces[info->iface_num];
+    if (iface->type == USB_IFACE_TYPE_DISABLED) {
+      iface->type = USB_IFACE_TYPE_BULK;
+      iface->port = info->emu_port;
+      iface->handle = info->handle;
+      return sectrue;
+    }
+  }
+  return secfalse;
+}
+
 static secbool usb_emulated_poll_read(usb_iface_t *iface) {
   if (iface->msg_len > 0) {
     return sectrue;
@@ -155,7 +188,9 @@ static secbool usb_emulated_poll_read(usb_iface_t *iface) {
     return secfalse;
   }
 
-  size_t len = sock_recvfrom(&iface->sock, iface->msg, sizeof(iface->msg));
+  size_t max_len = (iface->type == USB_IFACE_TYPE_BULK) ? sizeof(iface->msg)
+                                                         : USB_PACKET_LEN;
+  size_t len = sock_recvfrom(&iface->sock, iface->msg, max_len);
   if (!len) {
     return secfalse;
   }
@@ -200,6 +235,10 @@ static int usb_emulated_read(usb_iface_t *iface, uint8_t *buf, uint32_t len) {
 
 static ssize_t usb_emulated_write(usb_iface_t *iface, const uint8_t *buf,
                                   uint32_t len) {
+  if (iface->type == USB_IFACE_TYPE_BULK &&
+      (len < 1 || len > USB_BULK_FRAME_MAX)) {
+    return -1;
+  }
   return sock_sendto(&iface->sock, buf, len);
 }
 
