From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jean Herail <jeanherail@icloud.com>
Date: Sun, 18 Oct 2026 12:57:06 +0200
Subject: [PATCH] Support bounded 128-byte on-device backup passphrases

Feuristic-Rationale: Match the versioned backup format without expanding ordinary label buffers or allocating unbounded input.

diff --git a/core/embed/rust/src/strutil.rs b/core/embed/rust/src/strutil.rs
index 83d754823626813a8e06e34c3fec953a5fb46949..e11fd9bab707b8878e71336f0e46b5e12c19103e 100644
--- a/core/embed/rust/src/strutil.rs
+++ b/core/embed/rust/src/strutil.rs
@@ -10,6 +10,11 @@ use crate::translations::TR;
 /// Unified-length String type, long enough for most simple use-cases.
 pub type ShortString = String<50>;
 
+/// Bounded on-device input, including feuristic backup passphrases (12..128
+/// ASCII). Kept separate from ShortString so ordinary labels retain their small
+/// buffers.
+pub type InputString = String<128>;
+
 pub fn hexlify(data: &[u8], buffer: &mut [u8]) {
     const HEX_LOWER: [u8; 16] = *b"0123456789abcdef";
     let mut i: usize = 0;
@@ -309,6 +314,19 @@ impl ufmt::uDebug for TString<'_> {
 
 #[cfg(test)]
 mod tests {
+    #[test]
+    fn backup_input_bounds_and_memory() {
+        use super::{InputString, ShortString};
+        let mut input = InputString::new();
+        for _ in 0..128 {
+            assert!(input.push('a').is_ok());
+        }
+        assert_eq!(input.len(), 128);
+        assert!(input.push('b').is_err());
+        assert!(ShortString::new().capacity() == 50);
+        // Only input buffers grow; no allocator or unbounded String is used.
+        assert!(core::mem::size_of::<InputString>() <= 128 + 2 * core::mem::size_of::<usize>());
+    }
 
     #[test]
     fn test_format_code() {
