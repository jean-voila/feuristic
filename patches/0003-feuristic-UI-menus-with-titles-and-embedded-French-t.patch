     if blob.is_some() {
         return;
@@ -87,6 +93,23 @@ pub fn init() {
     }
 }
 
+/// feuristic: French translations embedded in the firmware image.
+static FEURISTIC_FR_BLOB: &[u8] = include_bytes!(concat!(env!("OUT_DIR"), "/feuristic_fr.bin"));
+
+/// feuristic: select the embedded French blob (`true`) or built-in English
+/// (`false`). Fails if a layout currently holds the translations.
+pub fn set_embedded_french(enabled: bool) -> Result<(), Error> {
+    let Some(mut blob) = TRANSLATIONS_ON_FLASH.try_write() else {
+        return Err(value_error!(c"Translations are in use."));
+    };
+    *blob = if enabled {
+        Some(Translations::new_trusted(FEURISTIC_FR_BLOB)?)
+    } else {
+        None
+    };
+    Ok(())
+}
+
 /// Deinitialize translations subsystem.
 ///
 /// If the blob is locked by a reader, `deinit()` will return an error.
