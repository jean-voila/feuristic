+/// feuristic: embed the French translation blob (generated by the pre-build
+/// step from core/translations/fr.json) into the firmware image, so that the
+/// device never loads translations from the host.
+fn embed_feuristic_french_blob() -> Result<()> {
+    let model = xbuild::current_model_id()?;
+    let dir = std::path::Path::new(&env::var("CARGO_MANIFEST_DIR").unwrap()).join("../../translations");
+    let prefix = format!("translation-{model}-fr-FR-");
+    let mut found = None;
+    for entry in std::fs::read_dir(&dir)? {
+        let path = entry?.path();
+        let name = path.file_name().and_then(|n| n.to_str()).unwrap_or("");
+        if name.starts_with(&prefix) && name.ends_with("-unsigned.bin") {
+            found = Some(path);
+        }
+    }
+    let Some(src) = found else {
+        xbuild::bail!("French translation blob for {model} not found in {}", dir.display());
+    };
+    println!("cargo:rerun-if-changed={}", src.display());
+    let out = std::path::Path::new(&env::var("OUT_DIR").unwrap()).join("feuristic_fr.bin");
+    std::fs::copy(&src, &out)?;
+    Ok(())
+}
+
 fn generate_trezorhal_bindings(lib: &mut CLibrary) -> Result<()> {
     // Tell cargo to invalidate the built crate whenever the header changes.
     println!("cargo:rerun-if-changed=trezorhal.h");
