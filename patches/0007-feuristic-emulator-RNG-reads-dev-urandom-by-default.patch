From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: feuristic build <build@feuristic.invalid>
Date: Sun, 18 Oct 2026 05:16:54 +0200
Subject: [PATCH] feuristic: emulator RNG reads /dev/urandom by default
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The deterministic LCG (crypto/rand_insecure.c) is heavily biased: one byte
in four is 0x40/0xC0. It made the SP 800-90B health tests of the GET
CHALLENGE service fail in the emulator. It is now only used when
FEURISTIC_DETERMINISTIC_RNG is set. Hardware builds are unaffected (STM32
TRNG, XORed with the Optiga RNG for strong randomness).

Feuristic-Rationale: spec §7 / R11 (RNG health), realistic emulator tests.

diff --git a/core/embed/sys/rng/unix/rng.c b/core/embed/sys/rng/unix/rng.c
index 071eece2f001a7bf3e2af94aedae9aa0d163ed8f..db1ddf4990c00aab3627f545405253b01e8d63ab 100644
--- a/core/embed/sys/rng/unix/rng.c
+++ b/core/embed/sys/rng/unix/rng.c
@@ -21,15 +21,23 @@
 
 #include <sys/rng.h>
 
+#include <stdio.h>
+#include <stdlib.h>
+
 #include "rand.h"
 
 void rng_fill_buffer(void* buffer, size_t buffer_size) {
 #ifdef USE_INSECURE_PRNG
 
-  // Use PRNG implemented in crypto/rand_insecure.c
-  random_buffer((uint8_t*)buffer, buffer_size);
+  // feuristic: the deterministic LCG of crypto/rand_insecure.c is heavily
+  // biased (detected by the SP 800-90B health tests of the GET CHALLENGE
+  // service). Use it only when explicitly requested for reproducible runs.
+  if (getenv("FEURISTIC_DETERMINISTIC_RNG") != NULL) {
+    random_buffer((uint8_t*)buffer, buffer_size);
+    return;
+  }
 
-#else
+#endif
 
   static FILE* frand = NULL;
   if (!frand) {
@@ -38,6 +46,4 @@ void rng_fill_buffer(void* buffer, size_t buffer_size) {
   ensure(sectrue * (frand != NULL), "fopen failed");
   ensure(sectrue * (buffer_size == fread(buffer, 1, buffer_size, frand)),
          "fread failed");
-
-#endif
 }
