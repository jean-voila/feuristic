From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Jean Herail <jeanherail@icloud.com>
Date: Thu, 22 Oct 2026 21:31:13 +0200
Subject: [PATCH] Update host CA bundle for compromised emSign intermediates

Feuristic-Rationale: Apply certifi 2026.10.19 for GHSA-6q48-6c7w-9gw2 in the build environment; exempt only certifi from the upstream 30-day release delay so the security fix can be selected.

diff --git a/pyproject.toml b/pyproject.toml
index 5c8b4f294b7855912ecfb2faf70094432f7a3f9d..4cc4247fe2e44f7038b57ac9e2cb6e8131ccd51b 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -72,6 +72,7 @@ dev = [
 [tool.uv]
 package = false
 exclude-newer = "30 days"
+exclude-newer-package = { certifi = "0 days" }
 
 [tool.uv.sources]
 trezor = { path = "./python", editable = true }
diff --git a/uv.lock b/uv.lock
index 4dfc528df89f378904b96d183169b594a1bf35d4..fa2b254075ab173f0f81dd205ae73dc1b171e2e7 100644
--- a/uv.lock
+++ b/uv.lock
@@ -12,6 +12,9 @@ resolution-markers = [
 exclude-newer = "0001-01-01T00:00:00Z" # This has no effect and is included for backwards compatibility when using relative exclude-newer values.
 exclude-newer-span = "P30D"
 
+[options.exclude-newer-package]
+certifi = { timestamp = "0001-01-01T00:00:00Z", span = "PT0S" }
+
 [[package]]
 name = "astroid"
 version = "3.3.11"
@@ -210,11 +213,11 @@ wheels = [
 
 [[package]]
 name = "certifi"
-version = "2025.8.3"
+version = "2026.10.19"
 source = { registry = "https://pypi.org/simple" }
-sdist = { url = "https://files.pythonhosted.org/packages/dc/67/960ebe6bf230a96cda2e0abcf73af550ec4f090005363542f0765df162e0/certifi-2025.8.3.tar.gz", hash = "sha256:e564105f78ded564e3ae7c923924435e1daa7463faeab5bb932bc53ffae63407", size = 162386, upload-time = "2025-08-03T03:07:47.08Z" }
+sdist = { url = "https://files.pythonhosted.org/packages/a6/bd/1436c50cc46699de0230fbaacc1d1de7bfec413176099949e9d5112e88f2/certifi-2026.10.19.tar.gz", hash = "sha256:035c1e85572b141bf1c3a3eff0e33a8eb74917522f2559075ff8d2fea780a1ae", size = 137598, upload-time = "2026-10-20T02:24:16.604Z" }
 wheels = [
-    { url = "https://files.pythonhosted.org/packages/e5/48/1549795ba7742c948d2ad169c1c8cdbae65bc450d6cd753d124b17c8cd32/certifi-2025.8.3-py3-none-any.whl", hash = "sha256:f6c12493cfb1b06ba2ff328595af9350c65d6644968e5d3a2ffd78699af217a5", size = 161216, upload-time = "2025-08-03T03:07:45.777Z" },
+    { url = "https://files.pythonhosted.org/packages/c4/51/29046e48f693c54e5b7412216d447a1d8362c9653148d98c02cdf65fa733/certifi-2026.10.19-py3-none-any.whl", hash = "sha256:42d35340cc5b9ba78e818ddbff0c5b1c2b779de448a340fd1b989f5fa8670e1b", size = 136464, upload-time = "2026-10-20T02:24:15.072Z" },
 ]
 
 [[package]]
